<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MakersMarkt.OrdersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MakersMarkt"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F5F0EE">

        <StackPanel Padding="40,36,40,40" Spacing="0" HorizontalAlignment="Stretch">

            <!-- PAGE HEADER -->
            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="My Orders"
                           FontSize="34"
                           FontFamily="{StaticResource CuteFont}"
                           Foreground="#3D3330"
                           HorizontalAlignment="Left"/>
                <Rectangle Height="3" Width="52" Fill="#E8A598"
                           HorizontalAlignment="Left" RadiusX="2" RadiusY="2"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- ORDER LIST -->
            <ListView x:Name="OrdersList"
                      SelectionMode="None"
                      IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                CornerRadius="16"
                                Margin="0,0,0,14"
                                BorderBrush="#EDE0DB"
                                BorderThickness="1.5">

                            <Grid Padding="20,18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- TOP ROW: status badge + date -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                        Background="#FDE8E3"
                                        CornerRadius="20"
                                        Padding="16,6">
                                        <TextBlock Text="{Binding Status}"
                                           FontSize="15"
                                           FontFamily="{StaticResource CuteFont}"
                                           Foreground="#C0604E"
                                           FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Date -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DateFormatted}"
                                               FontSize="12"
                                               Foreground="#B0A09C"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <!-- DIVIDER -->
                                <Rectangle Grid.Row="1"
                                           Height="1"
                                           Fill="#F0E8E4"
                                           Margin="0,0,0,10"/>

                                <!-- BOTTOM ROW: product count + review button -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="📦"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ProductCount}"
                                                   FontSize="13"
                                                   Foreground="#8A7C78"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="✏️  Write Review"
                                            Style="{StaticResource PastelButtonStyle}"
                                            Visibility="{Binding CanReview}"
                                            Click="WriteReview_Click"
                                            FontSize="13"
                                            Padding="14,7"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- EMPTY STATE -->
            <StackPanel x:Name="EmptyState"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        Spacing="10"
                        Margin="0,48,0,0">
                <TextBlock Text="🛍️"
                           FontSize="48"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="No orders yet"
                           FontSize="18"
                           FontFamily="{StaticResource CuteFont}"
                           Foreground="#B0A09C"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Your orders will show up here once you place one."
                           FontSize="13"
                           Foreground="#C8BBBA"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>