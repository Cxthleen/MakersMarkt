<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MakersMarkt.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MakersMarkt"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#EBE7E7">

        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <Border Background="White"
                    CornerRadius="25"
                    Width="1100"
                    Height="600">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                          Padding="60"
                          Background="White">

                        <StackPanel Spacing="20"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Welcome"
                                       FontSize="40"
                                       FontFamily="{StaticResource CuteFont}"
                                       HorizontalAlignment="Center"
                                       Foreground="#3A2F28"/>

                            <Grid Height="45">
                                <TextBox x:Name="UsernameBox"
                                     PlaceholderText="Username"
                                     Height="45"
                                     Background="{ThemeResource TextControlBackground}"
                                     BorderBrush="{ThemeResource TextControlBackground}"
                                     Foreground="#42352C"
                                     CornerRadius="8"
                                     Padding="40,11,12,0"
                                     VerticalContentAlignment="Center"/>

                                <FontIcon Glyph="&#xE77B;"
                                      FontSize="20"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Margin="12,0,0,0"
                                      Foreground="#42352C"
                                      IsHitTestVisible="False"/>
                            </Grid>

                            <Grid Height="45">
                                <PasswordBox x:Name="PasswordBox"
                                     PlaceholderText="Password"
                                     Height="45"
                                     Background="{ThemeResource PasswordBoxBackground}"
                                     BorderBrush="{ThemeResource PasswordBoxBackground}"
                                     Foreground="#42352C"
                                     CornerRadius="8"
                                     Padding="40,11,12,0"
                                     VerticalContentAlignment="Center"/>

                                <FontIcon Glyph="&#xE72E;"
                                  FontSize="20"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Margin="12,0,0,0"
                                  Foreground="#42352C"
                                  IsHitTestVisible="False"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="15"
                                        Margin="0,10,0,0">

                                <Button Content="Login"
                                        Width="140"
                                        Height="45"
                                        Background="{ThemeResource ButtonBackground}"
                                        BorderBrush="{ThemeResource ButtonBackground}"
                                        Foreground="#4D5A42"
                                        CornerRadius="8"
                                        Click="Login_Click"/>

                                <Button Content="Register"
                                        Width="140"
                                        Height="45"
                                        Background="{ThemeResource ButtonBackground}"
                                        BorderBrush="{ThemeResource ButtonBackground}"
                                        Foreground="#4D5A42"
                                        CornerRadius="8"
                                        Click="Register_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="1"
                            CornerRadius="0,25,25,0"
                            Background="LightGray">

                        <Image Source="/Assets/kitty.jpg"
                               Stretch="UniformToFill"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
