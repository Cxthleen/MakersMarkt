<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MakersMarkt.Dashboards.SellerDashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MakersMarkt.Dashboards"
    xmlns:models="using:MakersMarkt.Data.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="White">

    <Grid Padding="40">
        <Border Background="#e8e8e8" CornerRadius="4" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="WelcomeText"
                                   FontSize="14"
                                   Foreground="#666666"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="My Products"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Content="+ Add Product"
                            Background="#0c5adb"
                            Foreground="White"
                            Click="AddButton_Click"
                            Grid.Column="1"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- FILTER / SORT ROW -->
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Filter by Category -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Category" FontSize="12" Foreground="#666666" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CategoryFilter"
                                  Width="160"
                                  Background="White"
                                  SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Filter by Complexity -->
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Complexity" FontSize="12" Foreground="#666666" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ComplexityFilter"
                                  Width="160"
                                  Background="White"
                                  SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Medium"/>
                            <ComboBoxItem Content="High"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Sort -->
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="Sort by" FontSize="12" Foreground="#666666" Margin="0,0,0,4"/>
                        <ComboBox x:Name="SortBy"
                                  Width="180"
                                  Background="White"
                                  SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="Name (A → Z)" IsSelected="True"/>
                            <ComboBoxItem Content="Name (Z → A)"/>
                            <ComboBoxItem Content="Complexity"/>
                            <ComboBoxItem Content="Durability"/>
                        </ComboBox>
                    </StackPanel>

                </Grid>

                <!-- LIST OF PRODUCTS -->
                <Border Grid.Row="2"
                        Margin="0,16,0,0"
                        Background="White"
                        Padding="12"
                        CornerRadius="2">
                    <ListView x:Name="ProductsListView"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Product">
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="15"/>
                                        <TextBlock Text="{x:Bind Description}"
                                                   Foreground="#666666"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"/>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{x:Bind Category.Name}"
                                                       Foreground="#999999"
                                                       FontSize="12"/>
                                            <TextBlock Text="{x:Bind Complexity}"
                                                       Foreground="#999999"
                                                       FontSize="12"/>
                                            <TextBlock Text="{x:Bind Durability}"
                                                       Foreground="#999999"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Spacing="5">
                                        <Button Width="40" Height="40" Padding="0"
                                                Background="#90EE90"
                                                Click="Edit_Click">
                                            <Image Source="/Assets/Icons/PenInBox.png" Width="20" Height="20"/>
                                        </Button>
                                        <Button Width="40" Height="40" Padding="0"
                                                Background="#F44336"
                                                Click="Delete_Click">
                                            <Image Source="/Assets/Icons/Trashcan.png" Width="20" Height="20"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Page>