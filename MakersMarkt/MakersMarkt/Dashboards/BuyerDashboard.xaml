<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MakersMarkt.Dashboards.BuyerDashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MakersMarkt.Dashboards"
    xmlns:models="using:MakersMarkt.Data.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#1a1a1a">

    <Grid Padding="40">
        <Border Background="#1a1a1a" CornerRadius="4" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="WelcomeText"
                                   FontSize="14"
                                   Foreground="#aaaaaa"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="All Products"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </StackPanel>
                </Grid>

                <!-- FILTER / SORT ROW -->
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Category" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CategoryFilter"
                                  Width="160"
                                  Background="#2a2a2a"
                                  Foreground="White"
                                  SelectionChanged="Filter_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Complexity" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ComplexityFilter"
                                  Width="160"
                                  Background="#2a2a2a"
                                  Foreground="White"
                                  SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Medium"/>
                            <ComboBoxItem Content="High"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="Sort by" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                        <ComboBox x:Name="SortBy"
                                  Width="180"
                                  Background="#2a2a2a"
                                  Foreground="White"
                                  SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="Name (A → Z)" IsSelected="True"/>
                            <ComboBoxItem Content="Name (Z → A)"/>
                            <ComboBoxItem Content="Complexity"/>
                            <ComboBoxItem Content="Durability"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- PRODUCT LIST -->
                <Border Grid.Row="2"
                        Margin="0,16,0,0"
                        Background="#2a2a2a"
                        Padding="12"
                        CornerRadius="2">
                    <ListView x:Name="ProductsListView"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Product">
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="15"
                                                   Foreground="White"/>
                                        <TextBlock Text="{x:Bind Description}"
                                                   Foreground="#aaaaaa"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"/>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{x:Bind Category.Name}"
                                                       Foreground="#888888"
                                                       FontSize="12"/>
                                            <TextBlock Text="{x:Bind Complexity}"
                                                       Foreground="#888888"
                                                       FontSize="12"/>
                                            <TextBlock Text="{x:Bind Durability}"
                                                       Foreground="#888888"
                                                       FontSize="12"/>
                                            <TextBlock Text="{x:Bind Seller.DisplayName}"
                                                       Foreground="#4d8ffa"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="View"
                                            Background="#0c5adb"
                                            Foreground="White"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Click="View_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Page>