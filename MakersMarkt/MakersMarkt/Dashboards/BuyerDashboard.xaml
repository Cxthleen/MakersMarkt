<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MakersMarkt.Dashboards.BuyerDashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MakersMarkt.Dashboards"
    xmlns:models="using:MakersMarkt.Data.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#F5F0EE">

    <Grid Padding="40">
        <Border Background="#F5F0EE" CornerRadius="4" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="WelcomeText"
                                   FontSize="13"
                                   Foreground="#B0A09C"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="All Products"
                                   FontSize="34"
                                   FontFamily="{StaticResource CuteFont}"
                                   Foreground="#3D3330"/>
                        <Rectangle Height="3" Width="52" Fill="#E8A598"
                                   HorizontalAlignment="Left" RadiusX="2" RadiusY="2"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- FILTER / SORT ROW -->
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0" Spacing="4">
                        <TextBlock Text="Category"
                                   FontSize="11"
                                   Foreground="#B0A09C"
                                   FontWeight="SemiBold"/>
                        <ComboBox x:Name="CategoryFilter"
                                  Width="160"
                                  SelectionChanged="Filter_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0" Spacing="4">
                        <TextBlock Text="Complexity"
                                   FontSize="11"
                                   Foreground="#B0A09C"
                                   FontWeight="SemiBold"/>
                        <ComboBox x:Name="ComplexityFilter"
                                  Width="160"
                                  SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Medium"/>
                            <ComboBoxItem Content="High"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,12,0" Spacing="4">
                        <TextBlock Text="Sort by"
                                   FontSize="11"
                                   Foreground="#B0A09C"
                                   FontWeight="SemiBold"/>
                        <ComboBox x:Name="SortBy"
                                  Width="180"
                                  SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="Name (A → Z)" IsSelected="True"/>
                            <ComboBoxItem Content="Name (Z → A)"/>
                            <ComboBoxItem Content="Complexity"/>
                            <ComboBoxItem Content="Durability"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- PRODUCT LIST -->
                <Border Grid.Row="2"
                        Margin="0,16,0,0"
                        Background="White"
                        Padding="12"
                        CornerRadius="16"
                        BorderBrush="#EDE0DB"
                        BorderThickness="1.5">
                    <ListView x:Name="ProductsListView"
                              SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Product">
                                <Border Background="#FFF7F4"
                                        CornerRadius="12"
                                        Padding="16"
                                        Margin="0,0,0,8"
                                        BorderBrush="#EDE0DB"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{x:Bind Name}"
                                                       FontFamily="{StaticResource CuteFont}"
                                                       FontWeight="SemiBold"
                                                       FontSize="16"
                                                       Foreground="#3D3330"/>
                                            <TextBlock Text="{x:Bind Description}"
                                                       Foreground="#8A7C78"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1"/>
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Text="{x:Bind Category.Name}"
                                                           Foreground="#B0A09C"
                                                           FontSize="12"/>
                                                <TextBlock Text="{x:Bind Complexity}"
                                                           Foreground="#B0A09C"
                                                           FontSize="12"/>
                                                <TextBlock Text="{x:Bind Durability}"
                                                           Foreground="#B0A09C"
                                                           FontSize="12"/>
                                                <TextBlock Text="{x:Bind Seller.DisplayName}"
                                                           Foreground="#C0604E"
                                                           FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="View"
                                                Style="{StaticResource PastelButtonStyle}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Click="View_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Page>