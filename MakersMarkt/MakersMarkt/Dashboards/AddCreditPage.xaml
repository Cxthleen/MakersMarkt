<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MakersMarkt.Dashboards.AddCreditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#F2F2F7">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E5E5EA"
                BorderThickness="0,0,0,1"
                Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="← Terug"
                        Background="Transparent"
                        Foreground="#007AFF"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="BackButton_Click"
                        Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Winkelkrediet Toevoegen"
                               FontSize="17" FontWeight="SemiBold" Foreground="#1C1C1E"
                               FontFamily="Segoe UI Variable Display"/>
                    <TextBlock Text="Voeg krediet toe aan een koper account"
                               FontSize="12" Foreground="#8E8E93"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <StackPanel Grid.Row="1"
                    Padding="28,24"
                    MaxWidth="520"
                    HorizontalAlignment="Left"
                    Spacing="16">

            <!-- Buyer selector -->
            <Border Background="#FFFFFF" CornerRadius="12" Padding="20"
                    BorderBrush="#E5E5EA" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="KOPER SELECTEREN"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#8E8E93" CharacterSpacing="80"/>
                    <Border Height="1" Background="#F2F2F7"/>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Koper" FontSize="13" Foreground="#3C3C43"/>
                        <ComboBox x:Name="BuyerDropDown"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Selecteer een koper..."
                                  Background="#F2F2F7"
                                  SelectionChanged="BuyerDropDown_SelectionChanged"/>
                    </StackPanel>

                    <!-- Selected buyer info -->
                    <Border x:Name="BuyerInfoPanel"
                            Background="#F2F2F7" CornerRadius="8" Padding="14"
                            Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="BuyerDisplayName"
                                       FontSize="14" FontWeight="SemiBold" Foreground="#1C1C1E"/>
                            <TextBlock x:Name="BuyerUsername"
                                       FontSize="12" Foreground="#8E8E93"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Amount input -->
            <Border Background="#FFFFFF" CornerRadius="12" Padding="20"
                    BorderBrush="#E5E5EA" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="BEDRAG INVOEREN"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#8E8E93" CharacterSpacing="80"/>
                    <Border Height="1" Background="#F2F2F7"/>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Kredietbedrag (€)" FontSize="13" Foreground="#3C3C43"/>
                        <TextBox x:Name="AmountTextBox"
                                 PlaceholderText="bijv. 25.00"
                                 Background="#F2F2F7"
                                 BorderThickness="0"
                                 FontSize="15"
                                 Padding="12,10"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Notitie (optioneel)" FontSize="13" Foreground="#3C3C43"/>
                        <TextBox x:Name="NoteTextBox"
                                 PlaceholderText="Reden voor krediet toevoegen..."
                                 Background="#F2F2F7"
                                 BorderThickness="0"
                                 FontSize="13"
                                 Padding="12,10"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Save button -->
            <Button x:Name="SaveButton"
                    Content="Krediet Toevoegen"
                    HorizontalAlignment="Stretch"
                    Background="#34C759"
                    Foreground="White"
                    FontWeight="SemiBold"
                    FontSize="15"
                    Padding="0,14"
                    CornerRadius="12"
                    BorderThickness="0"
                    Click="SaveButton_Click"/>

            <!-- Feedback -->
            <TextBlock x:Name="FeedbackText"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Page>