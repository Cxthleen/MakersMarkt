<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MakersMarkt.Dashboards.ProductDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MakersMarkt.Data.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#1a1a1a">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="40">
            <Border Background="#1a1a1a" CornerRadius="4" Padding="24">
                <StackPanel>

                    <!-- BACK BUTTON -->
                    <Button Content="← Back"
                            Background="#0c5adb"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Click="BackButton_Click"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,20"/>

                    <!-- PRODUCT HEADER -->
                    <Border Background="#2a2a2a" CornerRadius="4" Padding="24" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="ProductName"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="CategoryName"
                                           FontSize="14"
                                           Foreground="#4d8ffa"
                                           Margin="0,0,0,8"/>
                                <TextBlock x:Name="SellerName"
                                           FontSize="13"
                                           Foreground="#aaaaaa"/>
                            </StackPanel>

                            <!-- ORDER BUTTON -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                                <Button x:Name="OrderButton"
                                        Content="🛒  Place Order"
                                        Background="#0c5adb"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        FontSize="16"
                                        Padding="24,12"
                                        Click="OrderButton_Click"/>
                                <TextBlock x:Name="OrderFeedback"
                                           FontSize="12"
                                           Foreground="#27ae60"
                                           HorizontalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DESCRIPTION -->
                    <Border Background="#2a2a2a" CornerRadius="4" Padding="24" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Description"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Margin="0,0,0,12"/>
                            <Border Height="2" Background="#444444" Margin="0,0,0,12"/>
                            <TextBlock x:Name="ProductDescription"
                                       FontSize="14"
                                       Foreground="#cccccc"
                                       TextWrapping="Wrap"
                                       LineHeight="22"/>
                        </StackPanel>
                    </Border>

                    <!-- SPECIFICATIONS -->
                    <Border Background="#2a2a2a" CornerRadius="4" Padding="24" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Specifications"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Margin="0,0,0,12"/>
                            <Border Height="2" Background="#444444" Margin="0,0,0,12"/>

                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Material -->
                                <Border Grid.Row="0" Grid.Column="0" Background="#333333" CornerRadius="4" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Material" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="MaterialText" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                </Border>

                                <!-- Production Time -->
                                <Border Grid.Row="0" Grid.Column="1" Background="#333333" CornerRadius="4" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Production Time" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="ProductionTimeText" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                </Border>

                                <!-- Complexity -->
                                <Border Grid.Row="1" Grid.Column="0" Background="#333333" CornerRadius="4" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Complexity" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="ComplexityText" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                </Border>

                                <!-- Durability -->
                                <Border Grid.Row="1" Grid.Column="1" Background="#333333" CornerRadius="4" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Durability" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="DurabilityText" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- REVIEWS -->
                    <Border Background="#2a2a2a" CornerRadius="4" Padding="24">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Reviews"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock x:Name="AverageRating"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#4d8ffa"/>
                                    <TextBlock x:Name="ReviewCount"
                                               FontSize="13"
                                               Foreground="#888888"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="2" Background="#444444" Margin="0,0,0,12"/>

                            <TextBlock x:Name="NoReviewsText"
                                       Text="No reviews yet."
                                       Foreground="#888888"
                                       FontSize="14"
                                       Visibility="Collapsed"/>

                            <ListView x:Name="ReviewsListView"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Review">
                                        <Border Background="#333333"
                                                CornerRadius="4"
                                                Padding="16"
                                                Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Buyer.DisplayName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"
                                                               Foreground="White"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind RatingDisplay}"
                                                               FontSize="14"
                                                               Foreground="#f4a023"/>
                                                </Grid>
                                                <TextBlock Text="{x:Bind ReviewText}"
                                                           FontSize="13"
                                                           Foreground="#cccccc"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>