<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MakersMarkt.Dashboards.EditProductPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="White">

    <StackPanel Padding="20,40" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#e8e8e8" CornerRadius="10">

        <TextBlock Text="Edit Product"
                   FontSize="40"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <Border Height="3" Background="#0c5adb" HorizontalAlignment="Stretch" Margin="0,0,0,20"/>

        <Grid ColumnSpacing="10" RowSpacing="10" Width="400">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="NameTextBox" Background="#f0f0f0" Grid.Row="0" Grid.Column="1"/>

            <TextBlock Text="Description:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="DescriptionTextBox" Background="#f0f0f0" Grid.Row="1" Grid.Column="1"/>

            <TextBlock Text="Material:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="MaterialTextBox" Background="#f0f0f0" Grid.Row="2" Grid.Column="1"/>

            <TextBlock Text="Production time:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="ProductionTimeTextBox" Background="#f0f0f0" Grid.Row="3" Grid.Column="1"/>

            <TextBlock Text="Complexity:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
            <DropDownButton x:Name="ComplexityDropDown" Grid.Row="4" Grid.Column="1"
                            Content="Select complexity" Background="#f0f0f0">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Low"    Click="Complexity_Click"/>
                        <MenuFlyoutItem Text="Medium" Click="Complexity_Click"/>
                        <MenuFlyoutItem Text="High"   Click="Complexity_Click"/>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <TextBlock Text="Durability:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
            <DropDownButton x:Name="DurabilityDropDown" Grid.Row="5" Grid.Column="1"
                            Content="Select durability" Background="#f0f0f0">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Low"    Click="Durability_Click"/>
                        <MenuFlyoutItem Text="Medium" Click="Durability_Click"/>
                        <MenuFlyoutItem Text="High"   Click="Durability_Click"/>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,20,0,0" HorizontalAlignment="Center">
            <Button Content="← Back" Click="BackButton_Click"
                    Background="#0c5adb" Foreground="White" FontWeight="SemiBold"/>
            <Button Content="Save changes" Click="SaveButton_Click"
                    Background="#0c5adb" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </StackPanel>
</Page>