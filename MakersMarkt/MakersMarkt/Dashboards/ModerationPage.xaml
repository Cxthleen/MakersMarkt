                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ReviewSnippetViewModel">
                                    <Border Padding="0,12" BorderBrush="#F2F2F7" BorderThickness="0,0,0,1">
                                        <StackPanel Spacing="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind ReviewerName}" FontSize="13" FontWeight="SemiBold" Foreground="#1C1C1E"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind RatingDisplay}" FontSize="12" Foreground="#FF9500"/>
                                            </Grid>
                                            <TextBlock Text="{x:Bind ReviewText}" FontSize="12" Foreground="#8E8E93" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ProductDetailNoReviews" Text="Geen recensies beschikbaar voor dit product." FontSize="13" Foreground="#C7C7CC" HorizontalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
        <Border x:Name="LoadingOverlay" Background="#80FFFFFF" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="40" Height="40" Foreground="#007AFF"/>
                <TextBlock Text="Laden..." FontSize="14" Foreground="#8E8E93" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        <InfoBar x:Name="StatusInfoBar" IsOpen="False" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="28,0,28,24"/>
    </Grid>
</Page>