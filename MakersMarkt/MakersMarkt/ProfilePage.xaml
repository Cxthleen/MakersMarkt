<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MakersMarkt.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MakersMarkt"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#FFF9F7F6" Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Your Profile"
               Style="{StaticResource CuteHeaderText}"
               FontSize="28"
               HorizontalAlignment="Center"
               Margin="0,0,0,20"/>

        <Border Grid.Row="1"
            Background="White"
            CornerRadius="20"
            Padding="30"
            BorderBrush="#E8DCD6"
            BorderThickness="2"
            HorizontalAlignment="Center"
            Width="500">

            <StackPanel Spacing="25" HorizontalAlignment="Center">

                <Grid>
                    <Ellipse Width="120" Height="120">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding ProfileImage}" />
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse Width="130" Height="130"
                             Stroke="#CBB9AD"
                             StrokeThickness="3"/>

                    <Button Content="✎"
                            Width="35"
                            Height="35"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,5,5"
                            Click="ChangeProfilePicture_Click"
                            Background="#F5EDEB"
                            BorderBrush="#D5C7BC"
                            CornerRadius="20"/>
                </Grid>

                <TextBlock Text="{Binding DisplayName}"
                           x:Name="ProfileTitle"
                       FontFamily="{StaticResource CuteFont}"
                       FontSize="26"
                       Foreground="#5C504D"
                       HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding Username}"
                       FontSize="16"
                       Foreground="#7A6F6B"
                       HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding Role}"
                       FontSize="14"
                       Foreground="#A08F89"
                       HorizontalAlignment="Center"/>

                <Rectangle Height="1"
                       Fill="#E8DCD6"
                       Margin="0,10"/>

                <StackPanel Spacing="12">

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Display Name:"
                               Width="120"
                               Foreground="#5C504D"/>
                        <TextBox Text="{Binding DisplayName, Mode=TwoWay}"
                                 TextChanged="DisplayName_TextChanged"
                             Style="{StaticResource PastelComboBox}"
                             MinWidth="250"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Biography:"
                               Width="120"
                               Foreground="#5C504D"/>
                        <TextBox Text="{Binding Biography, Mode=TwoWay}"
                             Style="{StaticResource PastelComboBox}"
                             MinWidth="250"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Height="80"/>
                    </StackPanel>

                </StackPanel>

                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="30"
                        Margin="0,10">

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Orders.Count}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#5C504D"
                               HorizontalAlignment="Center"/>
                        <TextBlock Text="Orders"
                               FontSize="14"
                               Foreground="#7A6F6B"
                               HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Reviews.Count}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#5C504D"
                               HorizontalAlignment="Center"/>
                        <TextBlock Text="Reviews"
                               FontSize="14"
                               Foreground="#7A6F6B"
                               HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Notifications.Count}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#5C504D"
                               HorizontalAlignment="Center"/>
                        <TextBlock Text="Notifications"
                               FontSize="14"
                               Foreground="#7A6F6B"
                               HorizontalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>

                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="15"
                        Margin="0,20,0,0">

                    <Button Content="Save"
                            Click="Save_Click"
                            Style="{StaticResource PastelButtonStyle}"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Page>
