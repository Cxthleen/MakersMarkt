<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MakersMarkt.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MakersMarkt"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <local:DateTimeToPrettyStringConverter x:Key="PrettyDateConverter"/>
        <local:BoolToFontWeightConverter x:Key="FontWeightConverter"/>
    </Page.Resources>

    <Grid Background="#FFF9F7F6" Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Your Profile"
               Style="{StaticResource CuteHeaderText}"
               FontSize="28"
               HorizontalAlignment="Center"
               Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

            <Border Background="White"
                CornerRadius="20"
                Padding="30"
                BorderBrush="#E8DCD6"
                BorderThickness="2"
                HorizontalAlignment="Center"
                Width="500">

                <Grid RowSpacing="25">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" HorizontalAlignment="Center">
                        <Ellipse Width="120" Height="120">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding ProfileImage}" />
                            </Ellipse.Fill>
                        </Ellipse>

                        <Ellipse Width="130" Height="130"
                             Stroke="#CBB9AD"
                             StrokeThickness="3"/>

                        <Button Content="✎"
                            Width="35"
                            Height="35"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,5,5"
                            Click="ChangeProfilePicture_Click"
                            Background="#F5EDEB"
                            BorderBrush="#D5C7BC"
                            CornerRadius="20"/>
                    </Grid>

                    <TextBlock Grid.Row="1"
                           Text="{Binding DisplayName}"
                           x:Name="ProfileTitle"
                           FontFamily="{StaticResource CuteFont}"
                           FontSize="26"
                           Foreground="#5C504D"
                           HorizontalAlignment="Center"/>

                    <TextBlock Grid.Row="2"
                           Text="{Binding Username}"
                           FontSize="16"
                           Foreground="#7A6F6B"
                           HorizontalAlignment="Center"/>

                    <TextBlock Grid.Row="3"
                           Text="{Binding Role}"
                           FontSize="14"
                           Foreground="#A08F89"
                           HorizontalAlignment="Center"/>

                    <Rectangle Grid.Row="4"
                           Height="1"
                           Fill="#E8DCD6"
                           Margin="0,10"/>

                    <StackPanel Grid.Row="5" Spacing="12">

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Display Name:"
                                   Width="100"
                                   Foreground="#5C504D"/>
                            <TextBox Text="{Binding DisplayName, Mode=TwoWay}"
                                 TextChanged="DisplayName_TextChanged"
                                 Style="{StaticResource PastelComboBox}"
                                 MinWidth="250"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Biography:"
                                   Width="100"
                                   Foreground="#5C504D"/>
                            <TextBox Text="{Binding Biography, Mode=TwoWay}"
                                 Style="{StaticResource PastelComboBox}"
                                 MinWidth="250"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="80"/>
                        </StackPanel>

                    </StackPanel>

                    <Grid Grid.Row="6" ColumnSpacing="30" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- ORDERS BUTTON -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Orders.Count}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#5C504D"
                                   HorizontalAlignment="Center"/>
                            <Button Content="My Orders"
                                Click="OpenOrders_Click"
                                Style="{StaticResource PastelButtonStyle}"
                                Width="120"
                                Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- REVIEWS BUTTON -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Reviews.Count}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#5C504D"
                               HorizontalAlignment="Center"/>
                            <Button Content="My Reviews"
                                Click="OpenReviews_Click"
                                Style="{StaticResource PastelButtonStyle}"
                                Width="120"
                                Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- NOTIFICATIONS BUTTON (kept cute + consistent) -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <Border Style="{StaticResource NotificationBadgeStyle}"
                                        Margin="0,10,0,5">
                                <TextBlock Text="{Binding Notifications.Count}"
                                       Foreground="White"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"/>
                            </Border>
                            <Button Content="Notifications"
                                Click="OpenNotifications_Click"
                                Style="{StaticResource PastelButtonStyle}"
                                Width="120"/>
                        </StackPanel>

                    </Grid>

                    <Button Grid.Row="7"
                        Content="Save"
                        Click="Save_Click"
                        HorizontalAlignment="Center"
                        Style="{StaticResource PastelButtonStyle}"
                        Margin="0,20,0,0"/>
                </Grid>
            </Border>
            
        </ScrollViewer>
        <ContentDialog x:Name="NotificationsDialog"
               Title="Notifications"
               PrimaryButtonText="Close"
               SecondaryButtonText="Mark all as read"
               DefaultButton="Primary"
               Background="White"
               CornerRadius="20"
               SecondaryButtonClick="MarkAllAsRead_Click">

            <ListView ItemsSource="{Binding Notifications}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="6" Spacing="8">

                            <StackPanel Orientation="Horizontal" Spacing="12" Tapped="Notification_Tapped">

                                <Ellipse Width="10" Height="10"
                                 VerticalAlignment="Center"
                                 Fill="{Binding IsRead, Converter={StaticResource BoolToColorConverter}}"/>

                                <StackPanel>
                                    <TextBlock Text="{Binding Type}"
                                       FontSize="16"
                                       Foreground="#42352C"
                                       FontWeight="{Binding IsRead, Converter={StaticResource FontWeightConverter}}"/>

                                    <TextBlock Text="{Binding CreatedAt, Converter={StaticResource PrettyDateConverter}}"
                                       FontSize="12"
                                       Foreground="#A08F89"/>
                                </StackPanel>

                            </StackPanel>

                            <Rectangle Height="1" Fill="#E8DCD6" Margin="0,4,0,0"/>

                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </ContentDialog>
    </Grid>
</Page>
